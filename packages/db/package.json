{
	"name": "@epoch-labs/db",
	"version": "0.0.0",
	"private": true,
	"files": [
		"dist"
	],
	"main": "/dist/index.mjs",
	"types": "/dist/index.d.ts",
	"exports": {
		".": {
			"default": "./dist/index.mjs",
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"scripts": {
		"build": "tsdown",
		"push": "drizzle-kit push",
		"studio": "drizzle-kit studio",
		"generate": "drizzle-kit generate --schema ./src/schema.ts --dialect postgresql --out ./drizzle",
		"migrate": "drizzle-kit generate --schema ./src/schema.ts --dialect postgresql --out ./drizzle",
		"seed:categories": "tsx src/scripts/seed-categories.ts",
		"seed:products": "tsx src/scripts/seed-products.ts",
		"seed:variants": "tsx src/scripts/seed-product-variants.ts"
	},
	"devDependencies": {
		"@epoch-labs/typescript-config": "workspace:*",
		"@types/node": "^25.6.0",
		"@types/pg": "^8.20.0",
		"drizzle-kit": "^0.31.10",
		"ts-node": "^10.9.2",
		"tsdown": "^0.22.1",
		"tsx": "^4.21.0",
		"typescript": "^6.0.2"
	},
	"dependencies": {
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"pg": "^8.20.0"
	}
}
